<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Supprocom.MathBlocks.Tests</AssemblyName>
    <RootNamespace>Supprocom.MathBlocks.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Supprocom.MathBlocks\Supprocom.MathBlocks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Supprocom.MathBlocks\Blocks\**\*.Tests.cs" LinkBase="Blocks" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Golden\ScalarCudaBlockCatalog.cu"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="Golden\VectorCudaBlockCatalog.cu"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="Golden\ComplexCudaBlockCatalog.cu"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="Golden\MatrixCudaBlockCatalog.cu"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="Golden\ProbabilityCudaBlockCatalog.cu"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="Golden\SequencePathCudaBlockCatalog.cu"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="Golden\StatisticsCudaBlockCatalog.cu"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="Golden\GeometryCudaBlockCatalog.cu"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="Golden\GraphCudaBlockCatalog.cu"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="Golden\AdvancedCudaBlockCatalog.cu"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="Golden\TransportCudaBlockCatalog.cu"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="Golden\DeviceDispatchCudaBlockCatalog.cu"
          CopyToOutputDirectory="PreserveNewest" />

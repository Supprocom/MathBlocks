<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Supprocom.MathBlocks.ExternalConsumer</AssemblyName>
    <RootNamespace>Supprocom.MathBlocks.ExternalConsumer</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MathBlocksVersion Condition="'$(MathBlocksVersion)' == ''">0.3.0</MathBlocksVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Supprocom.MathBlocks" Version="$(MathBlocksVersion)" />
  </ItemGroup>

</Project>

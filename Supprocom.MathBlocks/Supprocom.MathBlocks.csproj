<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Supprocom.MathBlocks</AssemblyName>
    <RootNamespace>Supprocom.MathBlocks</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>Supprocom.MathBlocks</PackageId>
    <Version>0.4.1</Version>
    <AssemblyVersion>0.4.1.0</AssemblyVersion>
    <Authors>Supprocom</Authors>
    <Company>Supprocom</Company>
    <Copyright>Copyright (C) 2026 mkn8rn</Copyright>
    <Description>Immutable mathematical-operation contracts for deterministic CPU and CUDA composition.</Description>
    <PackageDescription>Immutable mathematical-operation contracts for deterministic CPU and CUDA composition.</PackageDescription>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Supprocom/MathBlocks</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Supprocom/MathBlocks</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>mathematics;openmath;operation-contract;computation-graph;cpu;cuda;deterministic;numerics</PackageTags>
    <PackageReleaseNotes>Adds UTF-8, stream, async, diagnostic, validation, normalization, source-location, and Profile 1 discovery APIs for OpenMath.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <SourceRevisionId Condition="'$(RepositoryCommit)' != ''">$(RepositoryCommit)</SourceRevisionId>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="libtorch-cuda-12.8-win-x64-part1" Version="[2.10.0]" />
    <PackageReference Include="libtorch-cuda-12.8-win-x64-part8" Version="[2.10.0]" />
    <PackageReference Include="TorchSharp-cuda-linux" Version="[0.107.0]" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Blocks\**\*.Tests.cs" />
    <Compile Include="$(IntermediateOutputPath)MathBlockCudaGeneratedSource.g.cs" AutoGen="true" Visible="false" />
    <None Include="..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\LICENSE.md" Pack="true" PackagePath="LICENSE.md" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="THIRD-PARTY-NOTICES.md" />
    <None Include="..\docs\openmath-api.md" Pack="true" PackagePath="docs/openmath-api.md" />
    <None Include="..\openmath\v1\**\*"
          Pack="true"
          PackagePath="openmath/v1/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\openmath\v1\mathblocks_operations1.ocd"
                      LogicalName="Supprocom.MathBlocks.OpenMath.v1.mathblocks_operations1.ocd" />
    <EmbeddedResource Include="..\openmath\v1\mathblocks_profile1.cdg"
                      LogicalName="Supprocom.MathBlocks.OpenMath.v1.mathblocks_profile1.cdg" />
    <EmbeddedResource Include="..\openmath\v1\mathblocks_profile1.rnc"
                      LogicalName="Supprocom.MathBlocks.OpenMath.v1.mathblocks_profile1.rnc" />
    <EmbeddedResource Include="..\openmath\v1\mathblocks_program1.ocd"
                      LogicalName="Supprocom.MathBlocks.OpenMath.v1.mathblocks_program1.ocd" />
    <EmbeddedResource Include="..\openmath\v1\mathblocks_types1.ocd"
                      LogicalName="Supprocom.MathBlocks.OpenMath.v1.mathblocks_types1.ocd" />
    <EmbeddedResource Include="..\openmath\v1\mathblocks_values1.ocd"
                      LogicalName="Supprocom.MathBlocks.OpenMath.v1.mathblocks_values1.ocd" />
    <EmbeddedResource Include="..\openmath\v1\README.md"
                      LogicalName="Supprocom.MathBlocks.OpenMath.v1.README.md" />
    <AssemblyMetadata Include="RepositoryCommit" Value="$(RepositoryCommit)" Condition="'$(RepositoryCommit)' != ''" />
  </ItemGroup>

  <Target Name="ValidatePackageProvenance" BeforeTargets="_IntermediatePack">
    <Error Condition="'$(RepositoryCommit)' == ''" Text="RepositoryCommit is required for package creation." />
    <Error Condition="'$(RepositoryBranch)' == ''" Text="RepositoryBranch is required for package creation." />
  </Target>

  <Target Name="GenerateMathBlocksCudaSource" BeforeTargets="CoreCompile">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="dotnet run --project &quot;$(MSBuildProjectDirectory)/../build/MathBlocks.CudaSourceGenerator/MathBlocks.CudaSourceGenerator.csproj&quot; --configuration $(Configuration) --no-launch-profile -- --translation-root &quot;$(MSBuildProjectDirectory)/../build/MathBlocks.CudaSourceGenerator/TranslationUnits&quot; --golden-root &quot;$(MSBuildProjectDirectory)/../Supprocom.MathBlocks.Tests/Golden&quot; --generated-source &quot;$(IntermediateOutputPath)MathBlockCudaGeneratedSource.g.cs&quot; --generated-cuda &quot;$(IntermediateOutputPath)MathBlockCudaGeneratedSource.cu&quot;" />
  </Target>

</Project>

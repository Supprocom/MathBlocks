<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Supprocom.MathBlocks</AssemblyName>
    <RootNamespace>Supprocom.MathBlocks</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>Supprocom.MathBlocks</PackageId>
    <Version>0.6.1</Version>
    <AssemblyVersion>0.6.1.0</AssemblyVersion>
    <Authors>Supprocom</Authors>
    <Company>Supprocom</Company>
    <Copyright>Copyright (C) 2026 mkn8rn</Copyright>
    <Description>Typed mathematical-operation contracts with exhaustive OpenMath and Content MathML formula interchange, deterministic CoreCLR execution, and CUDA composition. CUDA execution uses the installed NVIDIA driver and CUDA Toolkit 12.0 or later; the package ships no native binaries.</Description>
    <PackageDescription>Typed mathematical-operation contracts with exhaustive OpenMath and Content MathML formula interchange, deterministic CoreCLR execution, and CUDA composition. CUDA execution uses the installed NVIDIA driver and CUDA Toolkit 12.0 or later; the package ships no native binaries.</PackageDescription>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Supprocom/MathBlocks</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Supprocom/MathBlocks</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>mathematics;openmath;mathml;content-mathml;operation-contract;computation-graph;coreclr;cuda;deterministic;numerics</PackageTags>
    <PackageReleaseNotes>Patch release. Results are bit-identical to 0.6.0 on CoreCLR and CUDA, except one fix: sequence.convolution@1 with exactly one empty operand is now invalid on CoreCLR, as it already was on CUDA. Faster on CoreCLR: elementwise forms, especially minimum and maximum; vector arithmetic and finiteness checks; and window.path.total-variation@1. Faster on CUDA: Spearman rank counts, Poisson CDF, distance correlation, Whitney and McShane extensions, dynamic time warping, and convolution. Adopt 0.6.1 at a run boundary: the CUDA device source, the operation table, the value codec implementation, and the device ABI fingerprint pins differ from 0.6.0, so a consumer that compares contract pins cannot resume or replay runs recorded on 0.6.0. The value codec schema and the causality pins are unchanged. CUDA execution uses the installed NVIDIA driver and CUDA Toolkit 12.0 or later; the package ships no native binaries.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SourceRevisionId Condition="'$(RepositoryCommit)' != ''">$(RepositoryCommit)</SourceRevisionId>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Blocks\**\*.Tests.cs" />
    <Compile Include="$(IntermediateOutputPath)MathBlockCudaGeneratedSource.g.cs" AutoGen="true" Visible="false" />
    <Compile Include="$(IntermediateOutputPath)MathBlockCudaTypeRuleGeneratedSource.g.cs" AutoGen="true" Visible="false" />
    <Compile Include="..\MathBlocks.CudaSourceGenerator\TranslationUnits\TypeRuleUnit.cs" Link="Cuda\TypeRuleUnit.cs" />
    <None Include="..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\LICENSE" Pack="true" PackagePath="" />
    <None Include="..\NOTICE" Pack="true" PackagePath="" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="THIRD-PARTY-NOTICES.md" />
    <None Include="..\docs\openmath-api.md" Pack="true" PackagePath="docs/openmath-api.md" />
    <None Include="..\docs\formula-interchange-api.md" Pack="true" PackagePath="docs/formula-interchange-api.md" />
    <None Include="..\docs\programming-model.md" Pack="true" PackagePath="docs/programming-model.md" />
    <None Include="..\docs\cuda-integration.md" Pack="true" PackagePath="docs/cuda-integration.md" />
    <None Include="..\docs\development.md" Pack="true" PackagePath="docs/development.md" />
    <None Include="..\openmath\v1\**\*"
          Pack="true"
          PackagePath="openmath/v1/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\formula\v1\**\*"
          Pack="true"
          PackagePath="formula/v1/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\openmath\v2\**\*"
          Pack="true"
          PackagePath="openmath/v2/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\formula\v2\**\*"
          Pack="true"
          PackagePath="formula/v2/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\openmath\v1\mathblocks_operations1.ocd"
                      LogicalName="Supprocom.MathBlocks.OpenMath.v1.mathblocks_operations1.ocd" />
    <EmbeddedResource Include="..\openmath\v1\mathblocks_profile1.cdg"
                      LogicalName="Supprocom.MathBlocks.OpenMath.v1.mathblocks_profile1.cdg" />
    <EmbeddedResource Include="..\openmath\v1\mathblocks_profile1.rnc"
                      LogicalName="Supprocom.MathBlocks.OpenMath.v1.mathblocks_profile1.rnc" />
    <EmbeddedResource Include="..\openmath\v1\mathblocks_program1.ocd"
                      LogicalName="Supprocom.MathBlocks.OpenMath.v1.mathblocks_program1.ocd" />
    <EmbeddedResource Include="..\openmath\v1\mathblocks_types1.ocd"
                      LogicalName="Supprocom.MathBlocks.OpenMath.v1.mathblocks_types1.ocd" />
    <EmbeddedResource Include="..\openmath\v1\mathblocks_values1.ocd"
                      LogicalName="Supprocom.MathBlocks.OpenMath.v1.mathblocks_values1.ocd" />
    <EmbeddedResource Include="..\openmath\v1\README.md"
                      LogicalName="Supprocom.MathBlocks.OpenMath.v1.README.md" />
    <EmbeddedResource Include="..\formula\v1\*.*"
                      LogicalName="Supprocom.MathBlocks.Formula.v1.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\openmath\v2\mathblocks_operations2.ocd"
                      LogicalName="Supprocom.MathBlocks.OpenMath.v2.mathblocks_operations2.ocd" />
    <EmbeddedResource Include="..\openmath\v2\mathblocks_profile2.cdg"
                      LogicalName="Supprocom.MathBlocks.OpenMath.v2.mathblocks_profile2.cdg" />
    <EmbeddedResource Include="..\openmath\v2\mathblocks_profile2.rnc"
                      LogicalName="Supprocom.MathBlocks.OpenMath.v2.mathblocks_profile2.rnc" />
    <EmbeddedResource Include="..\openmath\v2\mathblocks_program2.ocd"
                      LogicalName="Supprocom.MathBlocks.OpenMath.v2.mathblocks_program2.ocd" />
    <EmbeddedResource Include="..\openmath\v2\mathblocks_types2.ocd"
                      LogicalName="Supprocom.MathBlocks.OpenMath.v2.mathblocks_types2.ocd" />
    <EmbeddedResource Include="..\openmath\v2\mathblocks_values2.ocd"
                      LogicalName="Supprocom.MathBlocks.OpenMath.v2.mathblocks_values2.ocd" />
    <EmbeddedResource Include="..\openmath\v2\README.md"
                      LogicalName="Supprocom.MathBlocks.OpenMath.v2.README.md" />
    <EmbeddedResource Include="..\formula\v2\*.*"
                      LogicalName="Supprocom.MathBlocks.Formula.v2.%(Filename)%(Extension)" />
    <AssemblyMetadata Include="RepositoryCommit" Value="$(RepositoryCommit)" Condition="'$(RepositoryCommit)' != ''" />
    <AssemblyMetadata Include="RepositoryBranch" Value="$(RepositoryBranch)" Condition="'$(RepositoryBranch)' != ''" />
  </ItemGroup>

  <Target Name="ValidatePackageProvenance" BeforeTargets="_IntermediatePack">
    <Error Condition="'$(RepositoryCommit)' == ''" Text="RepositoryCommit is required for package creation." />
    <Error Condition="'$(RepositoryBranch)' == ''" Text="RepositoryBranch is required for package creation." />
    <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(RepositoryCommit)', '^[0-9a-fA-F]{40}$')) != 'True'"
           Text="RepositoryCommit must be one exact 40-character Git object name." />
    <Error Condition="'$(ExpectedRepositoryCommit)' != '' and '$(RepositoryCommit)' != '$(ExpectedRepositoryCommit)'"
           Text="RepositoryCommit does not match ExpectedRepositoryCommit." />
    <Error Condition="'$(ExpectedRepositoryBranch)' != '' and '$(RepositoryBranch)' != '$(ExpectedRepositoryBranch)'"
           Text="RepositoryBranch does not match ExpectedRepositoryBranch." />
  </Target>

  <Target Name="GenerateMathBlocksCudaSource" BeforeTargets="CoreCompile">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="dotnet run --project &quot;$(MSBuildProjectDirectory)/../MathBlocks.CudaSourceGenerator/MathBlocks.CudaSourceGenerator.csproj&quot; --configuration $(Configuration) --no-launch-profile -- --translation-root &quot;$(MSBuildProjectDirectory)/../MathBlocks.CudaSourceGenerator/TranslationUnits&quot; --golden-root &quot;$(MSBuildProjectDirectory)/../Supprocom.MathBlocks.Tests/Golden&quot; --generated-source &quot;$(IntermediateOutputPath)MathBlockCudaGeneratedSource.g.cs&quot; --generated-cuda &quot;$(IntermediateOutputPath)MathBlockCudaGeneratedSource.cu&quot; --generated-type-rule-source &quot;$(IntermediateOutputPath)MathBlockCudaTypeRuleGeneratedSource.g.cs&quot;" />
  </Target>

</Project>
